<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.google.android.permission.PROVIDE_BACKGROUND" />

    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:name=".WearApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".tile.FrontingTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.FrontingWithAvatarsTileService"
            android:exported="true"
            android:label="@string/tile_label_with_avatars"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.FrontingAvatarsOnlyTileService"
            android:exported="true"
            android:label="@string/tile_label_avatars_only"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <!-- Member-watch tile: per-instance multi-select. Tap on an
             unconfigured tile launches the picker; tap on a configured
             one opens the wear app. -->
        <service
            android:name=".tile.MemberFrontingTileService"
            android:exported="true"
            android:label="@string/tile_label_member_watch"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <activity
            android:name=".tile.MemberSelectorTileConfigActivity"
            android:exported="true"
            android:label="@string/tile_member_picker_label"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Quick-switch tile: per-instance multi-select pad of avatar
             buttons. Tap commits a "replace fronts with this member"
             switch via QuickSwitchTrampolineActivity. -->
        <service
            android:name=".tile.QuickSwitchTileService"
            android:exported="true"
            android:label="@string/tile_label_quick_switch"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <!-- Trampoline must be exported so the watchface tile-renderer
             system process can launch it on tile-click LaunchActions. The
             activity does not surface any UI; it just mutates per-tile
             SharedPreferences and (for commit) calls the API. Trade-off:
             any other app on the watch can in principle launch this
             trampoline with arbitrary mode + tile id. The blast radius
             is bounded — switches are reversible and visible in history
             — but worth replacing with a tighter mechanism eventually
             (e.g., a LoadAction-based state machine for the toggles +
             a separate API-backed receiver for commits). -->
        <!-- Recent-fronts timeline tile: read-only display of the
             client-side history ring buffer. Tap opens the history
             viewer screen via MainActivity deep-link. -->
        <service
            android:name=".tile.FrontHistoryTileService"
            android:exported="true"
            android:label="@string/tile_label_history"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <activity
            android:name=".tile.QuickSwitchTrampolineActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- Page-advance trampoline for paginated member-set tiles. Like
             the quick-switch trampoline it must be exported so the tile
             renderer can launch it; it only mutates the per-tile page
             index in SharedPreferences and requests a tile refresh, so
             a hostile launch can at worst flip which page is shown. -->
        <activity
            android:name=".tile.TilePageAdvanceActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <service
            android:name=".datalayer.WearDataLayerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/sheaf" />
            </intent-filter>
        </service>

        <!-- ── Complications ────────────────────────────────────────────────
             Six static complications. Each is a SuspendingComplicationDataSourceService
             with the standard ComplicationDataSourceService action filter,
             a SUPPORTED_TYPES list naming which ComplicationType each one
             can populate, and an UPDATE_PERIOD_SECONDS value that's mostly
             a freshness lower-bound — WearStore.requestComplicationUpdates
             pushes proactive refreshes whenever fronting state changes. -->

        <service
            android:name=".complications.OpenAppComplicationService"
            android:exported="true"
            android:label="@string/complication_open_app_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.datasource.ComplicationDataSourceService" />
                <!-- Legacy support-wearable action. Wear OS 6's complication
                     picker (the RWF/WFF one on Pixel Watch 3) still discovers
                     providers via the legacy action filter; declaring only
                     the modern AndroidX one gets us into PackageManager but
                     not into the watchface picker. SuspendingComplicationDataSourceService
                     responds to both internally. -->
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="MONOCHROMATIC_IMAGE,SMALL_IMAGE" />
            <meta-data
                android:name="androidx.wear.watchface.complications.SAFE_WATCH_FACE_SUPPORTED_TYPES"
                android:value="MONOCHROMATIC_IMAGE,SMALL_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <service
            android:name=".complications.QuickSwitchComplicationService"
            android:exported="true"
            android:label="@string/complication_quick_switch_label"
            android:icon="@drawable/ic_complication_swap"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.datasource.ComplicationDataSourceService" />
                <!-- Legacy support-wearable action. Wear OS 6's complication
                     picker (the RWF/WFF one on Pixel Watch 3) still discovers
                     providers via the legacy action filter; declaring only
                     the modern AndroidX one gets us into PackageManager but
                     not into the watchface picker. SuspendingComplicationDataSourceService
                     responds to both internally. -->
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="MONOCHROMATIC_IMAGE,SHORT_TEXT" />
            <meta-data
                android:name="androidx.wear.watchface.complications.SAFE_WATCH_FACE_SUPPORTED_TYPES"
                android:value="MONOCHROMATIC_IMAGE,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <service
            android:name=".complications.FrontersOldestFirstComplicationService"
            android:exported="true"
            android:label="@string/complication_fronters_oldest_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.datasource.ComplicationDataSourceService" />
                <!-- Legacy support-wearable action. Wear OS 6's complication
                     picker (the RWF/WFF one on Pixel Watch 3) still discovers
                     providers via the legacy action filter; declaring only
                     the modern AndroidX one gets us into PackageManager but
                     not into the watchface picker. SuspendingComplicationDataSourceService
                     responds to both internally. -->
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="androidx.wear.watchface.complications.SAFE_WATCH_FACE_SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <service
            android:name=".complications.FrontersNewestFirstComplicationService"
            android:exported="true"
            android:label="@string/complication_fronters_newest_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.datasource.ComplicationDataSourceService" />
                <!-- Legacy support-wearable action. Wear OS 6's complication
                     picker (the RWF/WFF one on Pixel Watch 3) still discovers
                     providers via the legacy action filter; declaring only
                     the modern AndroidX one gets us into PackageManager but
                     not into the watchface picker. SuspendingComplicationDataSourceService
                     responds to both internally. -->
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="androidx.wear.watchface.complications.SAFE_WATCH_FACE_SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <service
            android:name=".complications.FrontingDurationComplicationService"
            android:exported="true"
            android:label="@string/complication_fronting_duration_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.datasource.ComplicationDataSourceService" />
                <!-- Legacy support-wearable action. Wear OS 6's complication
                     picker (the RWF/WFF one on Pixel Watch 3) still discovers
                     providers via the legacy action filter; declaring only
                     the modern AndroidX one gets us into PackageManager but
                     not into the watchface picker. SuspendingComplicationDataSourceService
                     responds to both internally. -->
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="androidx.wear.watchface.complications.SAFE_WATCH_FACE_SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="60" />
        </service>

        <service
            android:name=".complications.LastSwitchComplicationService"
            android:exported="true"
            android:label="@string/complication_last_switch_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.datasource.ComplicationDataSourceService" />
                <!-- Legacy support-wearable action. Wear OS 6's complication
                     picker (the RWF/WFF one on Pixel Watch 3) still discovers
                     providers via the legacy action filter; declaring only
                     the modern AndroidX one gets us into PackageManager but
                     not into the watchface picker. SuspendingComplicationDataSourceService
                     responds to both internally. -->
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="androidx.wear.watchface.complications.SAFE_WATCH_FACE_SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="60" />
        </service>

        <!-- Configurable per-member complication. Picker launches
             MemberPickerConfigActivity to ask the user which member this
             slot represents; the activity persists the selection per
             instance id and the service reads it back on each request. -->
        <service
            android:name=".complications.MemberFrontingComplicationService"
            android:exported="true"
            android:label="@string/complication_member_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.datasource.ComplicationDataSourceService" />
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="androidx.wear.watchface.complications.SAFE_WATCH_FACE_SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="60" />
            <meta-data
                android:name="android.support.wearable.complications.PROVIDER_CONFIG_ACTION"
                android:value="systems.lupine.sheaf.wear.complications.action.PICK_MEMBER" />
        </service>

        <activity
            android:name=".complications.MemberPickerConfigActivity"
            android:exported="true"
            android:label="@string/complication_member_picker_label"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="systems.lupine.sheaf.wear.complications.action.PICK_MEMBER" />
                <category android:name="android.support.wearable.complications.category.PROVIDER_CONFIG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
