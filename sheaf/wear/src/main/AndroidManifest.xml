<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.google.android.permission.PROVIDE_BACKGROUND" />

    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:name=".WearApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".tile.FrontingTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.FrontingWithAvatarsTileService"
            android:exported="true"
            android:label="@string/tile_label_with_avatars"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.FrontingAvatarsOnlyTileService"
            android:exported="true"
            android:label="@string/tile_label_avatars_only"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <!-- Member-watch tile: per-instance multi-select. Tap on an
             unconfigured tile launches the picker; tap on a configured
             one opens the wear app. -->
        <service
            android:name=".tile.MemberFrontingTileService"
            android:exported="true"
            android:label="@string/tile_label_member_watch"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <activity
            android:name=".tile.MemberSelectorTileConfigActivity"
            android:exported="true"
            android:label="@string/tile_member_picker_label"
            android:theme="@android:style/Theme.DeviceDefault" />

        <service
            android:name=".datalayer.WearDataLayerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/sheaf" />
            </intent-filter>
        </service>

        <!-- ── Complications ────────────────────────────────────────────────
             Six static complications. Each is a SuspendingComplicationDataSourceService
             with the standard ComplicationDataSourceService action filter,
             a SUPPORTED_TYPES list naming which ComplicationType each one
             can populate, and an UPDATE_PERIOD_SECONDS value that's mostly
             a freshness lower-bound — WearStore.requestComplicationUpdates
             pushes proactive refreshes whenever fronting state changes. -->

        <service
            android:name=".complications.OpenAppComplicationService"
            android:exported="true"
            android:label="@string/complication_open_app_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.datasource.ComplicationDataSourceService" />
                <!-- Legacy support-wearable action. Wear OS 6's complication
                     picker (the RWF/WFF one on Pixel Watch 3) still discovers
                     providers via the legacy action filter; declaring only
                     the modern AndroidX one gets us into PackageManager but
                     not into the watchface picker. SuspendingComplicationDataSourceService
                     responds to both internally. -->
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="MONOCHROMATIC_IMAGE,SMALL_IMAGE" />
            <meta-data
                android:name="androidx.wear.watchface.complications.SAFE_WATCH_FACE_SUPPORTED_TYPES"
                android:value="MONOCHROMATIC_IMAGE,SMALL_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <service
            android:name=".complications.QuickSwitchComplicationService"
            android:exported="true"
            android:label="@string/complication_quick_switch_label"
            android:icon="@drawable/ic_complication_swap"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.datasource.ComplicationDataSourceService" />
                <!-- Legacy support-wearable action. Wear OS 6's complication
                     picker (the RWF/WFF one on Pixel Watch 3) still discovers
                     providers via the legacy action filter; declaring only
                     the modern AndroidX one gets us into PackageManager but
                     not into the watchface picker. SuspendingComplicationDataSourceService
                     responds to both internally. -->
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="MONOCHROMATIC_IMAGE,SHORT_TEXT" />
            <meta-data
                android:name="androidx.wear.watchface.complications.SAFE_WATCH_FACE_SUPPORTED_TYPES"
                android:value="MONOCHROMATIC_IMAGE,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <service
            android:name=".complications.FrontersOldestFirstComplicationService"
            android:exported="true"
            android:label="@string/complication_fronters_oldest_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.datasource.ComplicationDataSourceService" />
                <!-- Legacy support-wearable action. Wear OS 6's complication
                     picker (the RWF/WFF one on Pixel Watch 3) still discovers
                     providers via the legacy action filter; declaring only
                     the modern AndroidX one gets us into PackageManager but
                     not into the watchface picker. SuspendingComplicationDataSourceService
                     responds to both internally. -->
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="androidx.wear.watchface.complications.SAFE_WATCH_FACE_SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <service
            android:name=".complications.FrontersNewestFirstComplicationService"
            android:exported="true"
            android:label="@string/complication_fronters_newest_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.datasource.ComplicationDataSourceService" />
                <!-- Legacy support-wearable action. Wear OS 6's complication
                     picker (the RWF/WFF one on Pixel Watch 3) still discovers
                     providers via the legacy action filter; declaring only
                     the modern AndroidX one gets us into PackageManager but
                     not into the watchface picker. SuspendingComplicationDataSourceService
                     responds to both internally. -->
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="androidx.wear.watchface.complications.SAFE_WATCH_FACE_SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <service
            android:name=".complications.FrontingDurationComplicationService"
            android:exported="true"
            android:label="@string/complication_fronting_duration_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.datasource.ComplicationDataSourceService" />
                <!-- Legacy support-wearable action. Wear OS 6's complication
                     picker (the RWF/WFF one on Pixel Watch 3) still discovers
                     providers via the legacy action filter; declaring only
                     the modern AndroidX one gets us into PackageManager but
                     not into the watchface picker. SuspendingComplicationDataSourceService
                     responds to both internally. -->
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="androidx.wear.watchface.complications.SAFE_WATCH_FACE_SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="60" />
        </service>

        <service
            android:name=".complications.LastSwitchComplicationService"
            android:exported="true"
            android:label="@string/complication_last_switch_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.datasource.ComplicationDataSourceService" />
                <!-- Legacy support-wearable action. Wear OS 6's complication
                     picker (the RWF/WFF one on Pixel Watch 3) still discovers
                     providers via the legacy action filter; declaring only
                     the modern AndroidX one gets us into PackageManager but
                     not into the watchface picker. SuspendingComplicationDataSourceService
                     responds to both internally. -->
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="androidx.wear.watchface.complications.SAFE_WATCH_FACE_SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="60" />
        </service>

        <!-- Configurable per-member complication. Picker launches
             MemberPickerConfigActivity to ask the user which member this
             slot represents; the activity persists the selection per
             instance id and the service reads it back on each request. -->
        <service
            android:name=".complications.MemberFrontingComplicationService"
            android:exported="true"
            android:label="@string/complication_member_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.datasource.ComplicationDataSourceService" />
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="androidx.wear.watchface.complications.SAFE_WATCH_FACE_SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="60" />
            <meta-data
                android:name="android.support.wearable.complications.PROVIDER_CONFIG_ACTION"
                android:value="systems.lupine.sheaf.wear.complications.action.PICK_MEMBER" />
        </service>

        <activity
            android:name=".complications.MemberPickerConfigActivity"
            android:exported="true"
            android:label="@string/complication_member_picker_label"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="systems.lupine.sheaf.wear.complications.action.PICK_MEMBER" />
                <category android:name="android.support.wearable.complications.category.PROVIDER_CONFIG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
